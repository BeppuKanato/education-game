{
  "name": "education-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run test && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "wrangler deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
